generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  vehicles     Vehicle[]
  trips        Trip[]
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Vehicle {
  id                String   @id @default(cuid())
  name              String
  batteryKwh        Float
  usableKwh         Float
  consumptionWhKm   Float // consumo baseline a ~100 km/h, clima mite
  maxChargeKw       Float
  chargeCurve       String // JSON: [{ socPct, kw }] potenza di ricarica in funzione della SoC
  connectors        String // JSON: ["CCS","Type2","CHAdeMO"]
  reserveSocPct     Float   @default(10)
  defaultDepartSoc  Float   @default(90)
  isCustom          Boolean @default(false)
  userId            String? // null = veicolo globale (seed) o "ospite"; altrimenti proprietario
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  trips Trip[]
}

model Trip {
  id          String   @id @default(cuid())
  originLabel String
  originLat   Float
  originLng   Float
  destLabel   String
  destLat     Float
  destLng     Float
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  userId      String? // null = viaggio "ospite"; altrimenti proprietario
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonId      String? // identificativo del browser ospite (cookie ev_anon): separa i viaggi degli anonimi
  prefs       String // JSON: { wTime, wCost, avoidTolls, avoidHighways, departSoc, arriveSoc, tempC }
  resultJson  String // JSON dell'ultimo risultato calcolato
  createdAt   DateTime @default(now())
}

// Cache generica con TTL per le risposte delle API esterne (geocoding/routing/OCM/Overpass/toll).
model Cache {
  key       String   @id
  value     String
  expiresAt DateTime
}
