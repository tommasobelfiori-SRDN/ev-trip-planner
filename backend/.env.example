# --- Database ---
DATABASE_URL="file:./db/ev.sqlite"

# --- Server ---
PORT=5174
# User-Agent richiesto dalle policy OSM (Nominatim/Overpass).
# NB: il WAF di Nominatim blocca (403) gli UA con parentesi o indirizzi email.
# Usa un token semplice tipo "NomeApp/versione". Identificati pure, ma senza "(...)" o email.
APP_USER_AGENT="EVTripPlanner/0.1"

# --- Routing ---
# OpenRouteService: chiave gratuita su https://openrouteservice.org/dev/#/signup
# Se assente, il backend usa il server pubblico OSRM (niente "evita pedaggi/autostrade", niente elevazione).
ORS_API_KEY=""

# --- Colonnine EV ---
# Open Charge Map: chiave gratuita su https://openchargemap.org/site/loginprovider/beginlogin
# NECESSARIA: senza chiave l'API risponde 403 e non vengono mostrate colonnine
# (i viaggi che richiedono ricarica risulteranno "non percorribili").
OCM_API_KEY=""

# --- Pedaggi (opzionale, più preciso) ---
# TollGuru free tier: https://tollguru.com/  Se assente si usa la stima interna per Paese.
TOLLGURU_API_KEY=""

# --- Endpoint esterni (override opzionale) ---
NOMINATIM_URL="https://nominatim.openstreetmap.org"
OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSRM_URL="https://router.project-osrm.org"
ORS_URL="https://api.openrouteservice.org"
OCM_URL="https://api.openchargemap.io/v3"
